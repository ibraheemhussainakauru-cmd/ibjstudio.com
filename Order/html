<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex"><meta name="referrer" content="no-referrer"><title>Your order | IBJSTUDIO</title>
<style>:root{color-scheme:dark}*{box-sizing:border-box}body{margin:0;background:#0a0a0a;color:#f2f0eb;font:400 16px/1.6 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}main{max-width:640px;margin:0 auto;padding:2rem 1.2rem 4rem}a{color:#d8bd8a}.brand{letter-spacing:.16em;font-weight:600;text-decoration:none;color:#f2f0eb}.brand b{color:#d8bd8a}h1{font-size:1.5rem;margin:2rem 0 .5rem}.muted{color:#a5a199}.item{border:1px solid #262626;background:#151515;padding:1rem;margin:1rem 0}.item h2{font-size:1rem;margin:0 0 .6rem}pre{white-space:pre-wrap;overflow-wrap:anywhere;background:#0f0f0f;border:1px solid #262626;padding:.8rem;margin:.6rem 0;font:inherit;font-size:.9rem}.btn{display:inline-block;padding:.7rem 1.2rem;background:#d8bd8a;color:#17130b;border:0;font:inherit;cursor:pointer;text-decoration:none}.ghost{background:none;color:#f2f0eb;border:1px solid #8a7550}</style></head>
<body><main><a class="brand" href="/"><b>IBJ</b>STUDIO</a><h1 id="h">Confirming your payment…</h1><p class="muted" id="s">Please wait. Do not close this page.</p><div id="items"></div><p><a class="btn ghost" href="/">Back to the shop</a></p></main>
<script>
(function(){var q=new URLSearchParams(location.search),ref=q.get('reference')||q.get('trxref')||'',h=document.getElementById('h'),s=document.getElementById('s'),box=document.getElementById('items');
function el(t,c,x){var e=document.createElement(t);if(c)e.className=c;if(x!=null)e.textContent=x;return e}
if(!/^IBJ-[a-f0-9]{32}$/.test(ref)){h.textContent='We could not find your order';s.textContent='Open this page from the link Paystack sends you after payment, or message us on the site.';return}
function paid(j){h.textContent='Payment confirmed';s.textContent='Thank you! Your items are below. Keep this page link to open them again: '+location.href;
j.items.forEach(function(i){var d=el('div','item'),t=el('h2',null,i.title);d.appendChild(t);
if(!i.content){d.appendChild(el('p','muted','Your item is being prepared and will be sent to your email. If you do not hear from us within 24 hours, please message us from the chat button on our site.'))}
else if(/^https:\/\//.test(i.content)){var a=el('a','btn','Open your download');a.href=i.content;a.rel='noopener';a.target='_blank';d.appendChild(a)}
else{var p=el('pre',null,i.content);d.appendChild(p);var b=el('button','btn','Copy');b.type='button';b.onclick=function(){(navigator.clipboard?navigator.clipboard.writeText(i.content):Promise.reject()).then(function(){b.textContent='Copied'},function(){var r=document.createRange();r.selectNodeContents(p);var g=getSelection();g.removeAllRanges();g.addRange(r);b.textContent='Selected, press Copy'});setTimeout(function(){b.textContent='Copy'},2500)};d.appendChild(b)}
box.appendChild(d)})}
function other(j){h.textContent=j.status==='failed'?'Payment not completed':j.status==='review'?'We are checking your payment':'We could not confirm your payment';s.textContent=j.message||j.error||'Please try again or message us.'}
function check(n){fetch('/api/verify?reference='+encodeURIComponent(ref)).then(function(r){return r.json()}).then(function(j){if(j.status==='paid')paid(j);else if(j.status==='pending'&&n<8){s.textContent='Waiting for confirmation from Paystack…';setTimeout(function(){check(n+1)},3000)}else other(j)}).catch(function(){other({message:'Network problem. Please refresh this page.'})})}
check(0)})();
</script></body></html>
