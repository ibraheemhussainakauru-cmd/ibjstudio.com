<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="robots" content="noindex"><meta name="referrer" content="no-referrer"><title>Your order | IBJSTUDIO</title>
<style>
:root{color-scheme:dark;--gold:#d8bd8a;--ink:#f2f0eb;--mute:#a5a199;--line:#262626}
*{box-sizing:border-box}
body{margin:0;background:#0a0a0a;color:var(--ink);font:300 16px/1.6 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;padding:env(safe-area-inset-top,0) 0 env(safe-area-inset-bottom,0)}
main{max-width:560px;margin:0 auto;padding:2rem 1.2rem 4rem;text-align:center}
a{color:var(--gold)}.brand{display:block;letter-spacing:.18em;text-decoration:none;color:var(--ink);margin-bottom:2rem}.brand b{color:var(--gold)}
h1{font:300 1.5rem/1.2 Georgia,serif;margin:.4rem 0}.muted{color:var(--mute)}.small{font-size:.82rem}
.btn{display:inline-block;padding:.95rem 1.8rem;background:var(--gold);color:#17130b;text-decoration:none;border:0;font-weight:500;font-size:.95rem;font-family:inherit;letter-spacing:.14em;cursor:pointer}
.btn.ghost{background:none;color:var(--gold);border:1px solid var(--gold);letter-spacing:.06em}
.scene{display:none}.scene.on{display:block}
/* vault door: light CSS, runs once */
.vault{width:190px;height:190px;margin:0 auto 1rem;display:block;overflow:visible}
.vault .ring{fill:none;stroke:var(--gold);stroke-width:3}
.vault .door{fill:#151515;stroke:var(--gold);stroke-width:2}
.vault .wheel{fill:none;stroke:var(--gold);stroke-width:2.5;transform-origin:100px 100px}
.vault .glow{opacity:0;transform-origin:100px 100px}
.run .wheel{animation:spin 1.1s cubic-bezier(.3,.7,.2,1) forwards}
.run .door.l{animation:openL .9s .9s cubic-bezier(.6,0,.2,1) forwards}
.run .door.r{animation:openR .9s .9s cubic-bezier(.6,0,.2,1) forwards}
.run .glow{animation:glow 1.1s .9s ease-out forwards}
@keyframes spin{to{transform:rotate(270deg)}}
@keyframes openL{to{transform:translateX(-46px)}}
@keyframes openR{to{transform:translateX(46px)}}
@keyframes glow{from{opacity:0;transform:scale(.6)}to{opacity:1;transform:scale(1.15)}}
.reveal{opacity:0;transform:translateY(8px)}.run .reveal{animation:up .7s 1.7s ease-out forwards}.run .reveal.b{animation-delay:2s}.run .reveal.c{animation-delay:2.3s}
@keyframes up{to{opacity:1;transform:none}}
.unlock{font:300 1.15rem/1.3 Georgia,serif;letter-spacing:.16em;color:var(--gold);margin:.6rem 0 1rem}
.items{margin:1.2rem 0;text-align:left}.items div{padding:.7rem 0;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;gap:1rem}
.items span{color:var(--mute);font-size:.8rem;letter-spacing:.08em;text-transform:uppercase}
.member{border:1px solid var(--line);padding:1rem;margin:1rem 0}.member b{display:block;color:var(--gold);letter-spacing:.14em;font-size:1.05rem}
.found{display:inline-block;margin-top:.5rem;font-size:.7rem;letter-spacing:.16em;padding:.2rem .6rem;border:1px solid var(--gold);color:var(--gold)}
@media(prefers-reduced-motion:reduce){.run .wheel,.run .door,.run .glow,.run .reveal{animation:none!important}.run .door.l{transform:translateX(-46px)}.run .door.r{transform:translateX(46px)}.run .glow{opacity:1}.run .reveal{opacity:1;transform:none}}
</style></head>
<body><main><a class="brand" href="/"><b>IBJ</b>STUDIO</a>
<div class="scene on" id="wait"><h1 id="h">Confirming your payment…</h1><p class="muted" id="s">Please wait. Do not close this page.</p><p><a class="btn ghost" href="/">Back to the shop</a></p></div>
<div class="scene" id="win">
<svg class="vault" viewBox="0 0 200 200" aria-hidden="true"><defs><radialGradient id="gl"><stop offset="0" stop-color="#f4dfae"/><stop offset="1" stop-color="#d8bd8a" stop-opacity="0"/></radialGradient></defs>
<circle class="glow" cx="100" cy="100" r="64" fill="url(#gl)"/>
<path class="door l" d="M100 24A76 76 0 0 0 100 176Z"/><path class="door r" d="M100 24A76 76 0 0 1 100 176Z"/>
<circle class="ring" cx="100" cy="100" r="78"/>
<g class="wheel"><circle cx="100" cy="100" r="22"/><path d="M100 78V56M100 122v22M78 100H56M122 100h22M84.4 84.4L68.8 68.8M115.6 115.6l15.6 15.6M84.4 115.6l-15.6 15.6M115.6 84.4l15.6-15.6"/></g></svg>
<p class="unlock reveal" id="u">YOUR CREATIVE ASSET HAS BEEN UNLOCKED.</p>
<div class="items reveal b" id="items"></div>
<div class="member reveal b" id="member" hidden></div>
<p class="reveal c"><a class="btn" id="enter" href="/vault">ENTER MY VAULT</a></p>
<p class="muted small reveal c">Order number (keep it, it also signs you in): <span id="ref"></span></p>
</div>
</main>
<script>
(function(){var q=new URLSearchParams(location.search),ref=q.get('reference')||q.get('trxref')||'',h=document.getElementById('h'),s=document.getElementById('s');
function el(t,c,x){var e=document.createElement(t);if(c)e.className=c;if(x!=null)e.textContent=x;return e}
if(!/^IBJ-[a-f0-9]{32}$/.test(ref)){h.textContent='We could not find your order';s.textContent='Open this page from the link Paystack sends you after payment, or message us from the chat button on the site.';return}
// This only runs after the SERVER has verified the payment with Paystack. A message in the page alone never unlocks anything.
function paid(j){document.getElementById('wait').classList.remove('on');var w=document.getElementById('win');w.classList.add('on');
var box=document.getElementById('items');(j.items||[]).forEach(function(i){var d=el('div');d.appendChild(el('b',null,i.title));d.appendChild(el('span',null,i.kind==='book'?'Digital book':'AI prompt'));box.appendChild(d)});
document.getElementById('ref').textContent=ref;
if(j.member){var m=document.getElementById('member');m.hidden=false;m.appendChild(el('p','muted small','Welcome to the IBJers community.'));m.appendChild(el('b',null,j.member.code));m.appendChild(el('p','muted small','Your permanent IBJer ID'));if(j.member.founding)m.appendChild(el('span','found','FOUNDING IBJER'))}
requestAnimationFrame(function(){w.classList.add('run')})}
function other(j){h.textContent=j.status==='failed'?'Payment not completed':j.status==='review'?'We are checking your payment':'We could not confirm your payment';s.textContent=j.message||j.error||'Please try again or message us.'}
function check(n){fetch('/api/verify?reference='+encodeURIComponent(ref),{credentials:'same-origin'}).then(function(r){return r.json()}).then(function(j){if(j.status==='paid')paid(j);else if(j.status==='pending'&&n<8){s.textContent='Waiting for confirmation from Paystack…';setTimeout(function(){check(n+1)},3000)}else other(j)}).catch(function(){if(n<3)setTimeout(function(){check(n+1)},3000);else other({error:'Network problem. Your payment is safe. Please reopen this page in a moment.'})})}
check(0)})();
</script></body></html>
