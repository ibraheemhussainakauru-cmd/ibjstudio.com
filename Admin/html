<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title>IBJSTUDIO Admin</title>
<style>:root{color-scheme:dark}*{box-sizing:border-box}body{margin:0;background:#0a0a0a;color:#f2f0eb;font:400 15px/1.5 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}.wrap{max-width:980px;margin:0 auto;padding:1rem}h1{font-size:1.1rem;letter-spacing:.14em;margin:0}h1 b{color:#d8bd8a}.top{display:flex;justify-content:space-between;align-items:center;padding:.6rem 0 1rem;border-bottom:1px solid #262626}
.tabs{display:flex;gap:.5rem;margin:1rem 0}.tabs button,.btn{font:inherit;padding:.55rem 1rem;background:none;color:#f2f0eb;border:1px solid #8a7550;cursor:pointer}.tabs button.on,.btn.go{background:#d8bd8a;color:#17130b;border-color:#d8bd8a}
input,textarea,select{width:100%;padding:.65rem;background:#101010;border:1px solid #262626;color:#f2f0eb;font:inherit}textarea{min-height:120px}.row{display:flex;gap:.6rem;flex-wrap:wrap;margin:.6rem 0}.row>*{width:auto}
.list .it{display:block;width:100%;text-align:left;background:#151515;border:1px solid #262626;color:#f2f0eb;padding:.8rem;margin:.5rem 0;cursor:pointer;font:inherit}.it b{display:flex;justify-content:space-between;gap:1rem}.it small{display:block;color:#a5a199}.dot{display:inline-block;width:9px;height:9px;border-radius:50%;background:#d8bd8a;margin-right:.4rem}
.badge{font-size:.7rem;padding:.1rem .5rem;border:1px solid #8a7550;color:#d8bd8a;text-transform:uppercase;letter-spacing:.06em}.msgs{display:flex;flex-direction:column;gap:.5rem;margin:1rem 0;max-height:52vh;overflow:auto}.m{max-width:80%;padding:.55rem .8rem;white-space:pre-wrap;overflow-wrap:anywhere}.m small{display:block;font-size:.68rem;opacity:.7}.m.customer{background:#242424;align-self:flex-start}.m.admin{background:#d8bd8a;color:#17130b;align-self:flex-end}
table{width:100%;border-collapse:collapse;font-size:.85rem}td,th{border-bottom:1px solid #262626;padding:.5rem;text-align:left;vertical-align:top}.muted{color:#a5a199}.err{color:#ff9a8a}.hide{display:none}</style></head>
<body><div class="wrap"><div class="top"><h1><b>IBJ</b>STUDIO ADMIN</h1><button class="btn hide" id="out">Sign out</button></div>
<div id="login"><p class="muted">Sign in to manage customer chats, orders and prompts.</p><div class="row"><input type="password" id="pw" placeholder="Admin password" autocomplete="current-password" style="max-width:340px"><button class="btn go" id="in">Sign in</button></div><p class="err" id="le"></p></div>
<div id="app" class="hide"><div class="tabs"><button data-t="inbox" class="on">Inbox</button><button data-t="orders">Orders</button><button data-t="prompts">Prompts</button></div>
<div id="inbox"><div class="row" id="filters"></div><div class="list" id="list"></div><div id="thread" class="hide"></div></div>
<div id="orders" class="hide"></div>
<div id="prompts" class="hide"><div class="row"><select id="psel" style="max-width:520px"></select></div><textarea id="ptext" placeholder="Paste the prompt (or a private download link) for this item"></textarea><div class="row"><button class="btn go" id="psave">Save</button><span class="muted" id="pmsg"></span></div></div></div></div>
<script>
(function(){var $=function(i){return document.getElementById(i)},cur='',open=null,tab='inbox',timers=[];
function api(p,o){o=o||{};o.credentials='same-origin';o.headers=Object.assign({'x-requested-with':'ibj-admin'},o.headers||{});if(o.body&&typeof o.body!=='string'){o.body=JSON.stringify(o.body);o.headers['content-type']='application/json'}return fetch(p,o).then(function(r){return r.json().then(function(j){return{s:r.status,j:j}},function(){return{s:r.status,j:{}}})})}
function el(t,c,x){var e=document.createElement(t);if(c)e.className=c;if(x!=null)e.textContent=x;return e}
function when(ms){return new Date(ms).toLocaleString()}
function show(on){$('login').classList.toggle('hide',on);$('app').classList.toggle('hide',!on);$('out').classList.toggle('hide',!on)}
$('in').onclick=function(){api('/api/admin/login',{method:'POST',body:{password:$('pw').value}}).then(function(x){if(x.s===200){$('pw').value='';start()}else $('le').textContent=x.j.error||'Could not sign in.'})};
$('pw').addEventListener('keydown',function(e){if(e.key==='Enter')$('in').click()});
$('out').onclick=function(){api('/api/admin/logout',{method:'POST',body:{}}).then(function(){location.reload()})};
document.querySelectorAll('.tabs button').forEach(function(b){b.onclick=function(){tab=b.dataset.t;document.querySelectorAll('.tabs button').forEach(function(x){x.classList.toggle('on',x===b)});['inbox','orders','prompts'].forEach(function(t){$(t).classList.toggle('hide',t!==tab)});if(tab==='orders')loadOrders();if(tab==='prompts')loadPrompts();if(tab==='inbox')loadList()}});
function start(){show(true);buildFilters();loadList();timers.forEach(clearInterval);timers=[setInterval(function(){if(!document.hidden&&tab==='inbox'){if(open)refreshThread();else loadList()}},6000)]}
function buildFilters(){var f=$('filters');f.innerHTML='';[['','All'],['new','New'],['open','Open'],['waiting','Waiting for customer'],['closed','Closed']].forEach(function(p){var b=el('button','btn'+(cur===p[0]?' go':''),p[1]);b.onclick=function(){cur=p[0];open=null;$('thread').classList.add('hide');$('list').classList.remove('hide');buildFilters();loadList()};f.appendChild(b)})}
function label(s){return s==='waiting'?'Waiting for customer':s.charAt(0).toUpperCase()+s.slice(1)}
function loadList(){api('/api/admin/conversations'+(cur?'?status='+cur:'')).then(function(x){if(x.s===401){show(false);return}var l=$('list');l.innerHTML='';if(!x.j.conversations.length)l.appendChild(el('p','muted','No conversations yet.'));x.j.conversations.forEach(function(c){var b=el('button','it');var h=el('b');var n=el('span');if(c.unread_admin)n.appendChild(el('span','dot'));n.appendChild(document.createTextNode(c.name||'Customer'));h.appendChild(n);h.appendChild(el('span','badge',label(c.status)));b.appendChild(h);b.appendChild(el('small',null,(c.email||'')+' · '+when(c.last_message_at)));b.appendChild(el('small',null,(c.last_sender==='admin'?'You: ':'')+c.preview));b.onclick=function(){openConv(c.id)};l.appendChild(b)})})}
function openConv(id){open=id;$('list').classList.add('hide');var t=$('thread');t.classList.remove('hide');t.innerHTML='';refreshThread(true)}
function refreshThread(full){api('/api/admin/conversation?id='+open+(full?'':'&peek=1')).then(function(x){if(x.s!==200)return;var c=x.j.conversation,t=$('thread');var ta=document.getElementById('reply');var keep=ta?ta.value:'';t.innerHTML='';
var back=el('button','btn','Back to inbox');back.onclick=function(){open=null;t.classList.add('hide');$('list').classList.remove('hide');loadList()};t.appendChild(back);
t.appendChild(el('h2',null,(c.name||'Customer')+' · '+(c.email||'')));var r=el('div','row');t.appendChild(r);r.appendChild(el('span','badge',label(c.status)));
var sel=el('select');['open','waiting','closed','new'].forEach(function(s){var o=el('option',null,label(s));o.value=s;if(s===c.status)o.selected=true;sel.appendChild(o)});sel.style.maxWidth='220px';sel.onchange=function(){api('/api/admin/conversation',{method:'POST',body:{id:open,action:'status',status:sel.value}}).then(function(){refreshThread(true)})};r.appendChild(sel);
var un=el('button','btn','Mark unread');un.onclick=function(){api('/api/admin/conversation',{method:'POST',body:{id:open,action:'unread',value:1}}).then(function(){open=null;t.classList.add('hide');$('list').classList.remove('hide');loadList()})};r.appendChild(un);
var m=el('div','msgs');x.j.messages.forEach(function(g){var d=el('div','m '+g.from,g.body);d.appendChild(el('small',null,when(g.at)));m.appendChild(d)});t.appendChild(m);m.scrollTop=m.scrollHeight;
var ta2=el('textarea');ta2.id='reply';ta2.placeholder='Type your reply';ta2.value=keep;t.appendChild(ta2);var send=el('button','btn go','Send reply');send.onclick=function(){var v=ta2.value.trim();if(!v)return;api('/api/admin/conversation',{method:'POST',body:{id:open,action:'reply',message:v}}).then(function(){ta2.value='';refreshThread(true)})};t.appendChild(send)})}
function loadOrders(){api('/api/admin/orders').then(function(x){var o=$('orders');o.innerHTML='';var tb=el('table'),hd=el('tr');['Date','Email','Items','USD','NGN','Status'].forEach(function(h){hd.appendChild(el('th',null,h))});tb.appendChild(hd);(x.j.orders||[]).forEach(function(r){var tr=el('tr');[when(r.created_at),r.email,r.items.join(', '),'$'+Number(r.usd_total).toFixed(2),'₦'+Number(r.ngn).toLocaleString('en-US'),r.status+(r.note?' ('+r.note+')':'')].forEach(function(v){tr.appendChild(el('td',null,v))});tb.appendChild(tr)});o.appendChild(tb);if(!(x.j.orders||[]).length)o.appendChild(el('p','muted','No orders yet.'))})}
function loadPrompts(){api('/api/admin/prompts').then(function(x){var s=$('psel');s.innerHTML='';(x.j.products||[]).forEach(function(p){var o=el('option',null,(p.hasContent?'✓ ':'• ')+p.title+' ($'+p.usd.toFixed(2)+')');o.value=p.id;s.appendChild(o)});s.onchange=pick;pick()})}
function pick(){var id=$('psel').value;if(!id)return;api('/api/admin/prompts?id='+encodeURIComponent(id)).then(function(x){$('ptext').value=x.j.content||'';$('pmsg').textContent=''})}
$('psave').onclick=function(){api('/api/admin/prompts',{method:'POST',body:{id:$('psel').value,content:$('ptext').value}}).then(function(x){$('pmsg').textContent=x.s===200?'Saved.':(x.j.error||'Could not save.');if(x.s===200)loadPrompts()})};
api('/api/admin/conversations').then(function(x){if(x.s===200)start()})})();
</script></body></html>
